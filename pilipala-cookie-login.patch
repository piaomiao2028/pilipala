+  /// 解析一整段 Cookie 文本（`a=1; b=2;` 或换行分隔均可）
+  /// 统一挂到 .bilibili.com 域，www / api / vc 各个子域都能命中
+  static List<Cookie> parseCookie(String rawCookie) {
+    final List<Cookie> cookies = [];
+    for (final String item in rawCookie.split(RegExp(r';|\n'))) {
+      final String text = item.trim();
+      if (text.isEmpty) continue;
+      final int index = text.indexOf('=');
+      if (index <= 0) continue;
+      final String name = text.substring(0, index).trim();
+      final String value = text.substring(index + 1).trim();
+      if (name.isEmpty || value.isEmpty) continue;
+      cookies.add(
+        Cookie(name, value)
+          ..domain = '.bilibili.com'
+          ..path = '/'
+          ..httpOnly = false,
+      );
+    }
+    return cookies;
+  }
+
+  /// 直接用 Cookie 登录（移植自 PiliPlus 的「使用Cookie登录」）
+  /// 返回 true 表示登录成功
+  static Future<bool> loginByCookie(String rawCookie) async {
+    final List<Cookie> cookies = parseCookie(rawCookie);
+    if (cookies.isEmpty || !cookies.any((e) => e.name == 'SESSDATA')) {
+      SmartDialog.showToast('Cookie 格式不正确，至少要包含 SESSDATA');
+      return false;
+    }
+    SmartDialog.showLoading(msg: '登录中...');
+    try {
+      // 1. 写入本地 cookie 仓库
+      await Request.cookieManager.cookieJar
+          .saveFromResponse(Uri.parse(HttpString.baseUrl), cookies);
+
+      // 2. 同步到全局请求头，保证接下来的校验请求带上
+      final List<Cookie> all = await Request.cookieManager.cookieJar
+          .loadForRequest(Uri.parse(HttpString.baseUrl));
+      Request.dio.options.headers['cookie'] =
+          all.map((e) => '${e.name}=${e.value}').join('; ');
+      Request.buvid = null; // 让 buvid 重新读取
+
+      // 3. 校验 Cookie 是否有效
+      final dynamic result = await UserHttp.userInfo();
+      if (result['status'] != true || result['data'].isLogin != true) {
+        SmartDialog.dismiss();
+        SmartDialog.showToast(result['msg'] ?? 'Cookie 已失效，请重新获取');
+        return false;
+      }
+
+      // 4. 保存用户信息 + 刷新各页面登录状态
+      Box userInfoCache = GStrorage.userInfo;
+      if (!userInfoCache.isOpen) {
+        userInfoCache = await Hive.openBox('userInfo');
+      }
+      await userInfoCache.put('userInfoCache', result['data']);
+
+      final HomeController homeCtr = Get.find<HomeController>();
+      homeCtr.updateLoginStatus(true);
+      homeCtr.userFace.value = result['data'].face;
+      Get.find<MediaController>().mid = result['data'].mid;
+      await LoginUtils.refreshLoginStatus(true);
+
+      SmartDialog.dismiss();
+      SmartDialog.showToast('登录成功');
+      return true;
+    } catch (e) {
+      SmartDialog.dismiss();
+      SmartDialog.showToast('登录失败：$e');
+      return false;
+    }
+  }
