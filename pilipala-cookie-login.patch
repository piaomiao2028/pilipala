+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_smart_dialog/flutter_smart_dialog.dart';
+import 'package:get/get.dart';
+import 'package:pilipala/utils/login.dart';
+
+/// 使用 Cookie 登录（移植自 PiliPlus）
+class CookieLoginDialog extends StatefulWidget {
+  const CookieLoginDialog({super.key});
+
+  @override
+  State<CookieLoginDialog> createState() => _CookieLoginDialogState();
+}
+
+class _CookieLoginDialogState extends State<CookieLoginDialog> {
+  final TextEditingController _cookieController = TextEditingController();
+  bool _loading = false;
+
+  @override
+  void dispose() {
+    _cookieController.dispose();
+    super.dispose();
+  }
+
+  Future<void> _login() async {
+    final String cookie = _cookieController.text.trim();
+    if (cookie.isEmpty) {
+      SmartDialog.showToast('Cookie 不能为空');
+      return;
+    }
+    setState(() => _loading = true);
+    final bool success = await LoginUtils.loginByCookie(cookie);
+    if (!mounted) return;
+    setState(() => _loading = false);
+    if (success) {
+      Get.back(); // 关闭本弹窗
+      Get.back(); // 关闭登录页
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return AlertDialog(
+      title: const Text('使用 Cookie 登录'),
+      contentPadding: const EdgeInsets.fromLTRB(20, 16, 20, 0),
+      content: SingleChildScrollView(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            const Text(
+              '需包含 SESSDATA、bili_jct、DedeUserID，缺一不可',
+              style: TextStyle(fontSize: 12),
+            ),
+            const SizedBox(height: 12),
+            TextField(
+              controller: _cookieController,
+              minLines: 3,
+              maxLines: 8,
+              style: const TextStyle(fontSize: 13),
+              inputFormatters: [
+                FilteringTextInputFormatter.deny(RegExp(r'\s')),
+              ],
+              decoration: const InputDecoration(
+                hintText: 'SESSDATA=xxx;bili_jct=xxx;DedeUserID=xxx;...',
+                border: OutlineInputBorder(),
+                isDense: true,
+              ),
+            ),
+          ],
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Get.back(),
+          child: const Text('取消'),
+        ),
+        FilledButton(
+          onPressed: _loading ? null : _login,
+          child: _loading
+              ? const SizedBox(
+                  width: 18,
+                  height: 18,
+                  child: CircularProgressIndicator(strokeWidth: 2),
+                )
+              : const Text('登录'),
+        ),
+      ],
+    );
+  }
+}
